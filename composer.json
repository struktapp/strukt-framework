{
    "name": "strukt/framework",
    "description": "Annotation-driven application kernel, facades, and console for Strukt.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "psr/container": "^1.1 || ^2.0",
        "strukt/base": "v1.0.0",
        "strukt/commons": "v1.1.0",
        "strukt/contract": "v1.0.0",
        "strukt/router": "v1.0.0",
        "strukt/cache": "v1.0.0",
        "strukt/event": "v1.0.1",
        "strukt/form": "v1.0.0",
        "strukt/fs": "v2.0.0",
        "strukt/generator": "v3.1.0",
        "strukt/console": "v2.0.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "psy/psysh": "^0.12.24"
    },
    "autoload": {
        "psr-4": {
            "Strukt\\": "src/Strukt/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/strukt",
        "bin/xhttp",
        "bin/link"
    ],
    "scripts": {
        "test": "pest",
        "lint": "find src tests bin -type f -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "pitsolu",
            "email": "pitsolu@gmail.com"
        }
    ],
    "version": "1.7.0"
}
